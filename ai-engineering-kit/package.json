{
  "name": "ai-engineering-kit", "version": "0.2.0",
  "description": "Local review UI and project-agnostic AI engineering workflow",
  "license": "MIT", "type": "module",
  "bin": { "aiek": "dist/server/cli.js" },
  "engines": { "node": ">=22.12.0" },
  "files": ["dist", "core", "skills", "speckit", "adapters", "scripts/install.sh", "scripts/init-project.sh", "manifest.json", "KIT.md", "NOTICE.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/version-check.mjs && tsc -p tsconfig.build.json && vite build",
    "dev": "npm run build && node dist/server/cli.js web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ui tests scripts/*.mjs *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3", "diff": "^8.0.2", "open": "^10.2.0",
    "react": "^19.0.0", "react-dom": "^19.0.0", "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1", "remark-parse": "^11.0.0", "unified": "^11.0.5", "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0", "@playwright/test": "^1.56.0", "@types/node": "^22.0.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0", "globals": "^16.0.0", "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0", "vite": "^7.1.0", "vitest": "^3.2.0"
  }
}

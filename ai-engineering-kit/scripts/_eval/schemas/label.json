{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "trial_id",
    "artifact_hash",
    "rubric_version",
    "passed",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "minLength": 64
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    }
  }
}

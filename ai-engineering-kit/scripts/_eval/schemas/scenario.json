{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "prompt",
    "setup",
    "assertions",
    "outcome"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "plus-email",
            "signup-copy",
            "human"
          ]
        },
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      }
    },
    "setup": {
      "type": "array"
    },
    "assertions": {
      "type": "array",
      "minItems": 1
    }
  }
}
